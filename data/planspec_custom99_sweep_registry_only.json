{
  "version": 1,
  "name": "Custom99 Sweep Test - EMA Cross + ROC Gate + Breakout Filter (Registry Only)",
  "trade_mode": "LongShort",
  "exec_settings": {
    "eval_mode": "SameBar",
    "fill_timing": "NextBarOpen",
    "costs": {
      "fee_bps": 1.0,
      "slippage_bps": 1.0
    },
    "exits_first": true,
    "allow_same_bar_reversal": false,
    "close_out_at_end": true
  },
  "params": {
    "ema_fast": 12,
    "ema_slow": 26,
    "roc_k": 10,
    "break_n": 20,
    "roc_floor": 0.0
  },
  "sweep": {
    "enabled": true,
    "top_k": 10,
    "max_evals": 20000,
    "objective": "pnl_dd",
    "dd_weight": 0.5,
    "params": {
      "ema_fast": {
        "values": [
          8,
          10,
          12,
          14,
          16
        ],
        "is_int": true
      },
      "ema_slow": {
        "values": [
          20,
          26,
          32,
          38
        ],
        "is_int": true
      },
      "roc_k": {
        "values": [
          5,
          10,
          15
        ],
        "is_int": true
      },
      "break_n": {
        "values": [
          10,
          20,
          30
        ],
        "is_int": true
      }
    }
  },
  "numeric_nodes": [
    {
      "id": "close",
      "op": "core.close"
    },
    {
      "id": "ema_f",
      "op": "ts.ema",
      "args": [
        "close"
      ],
      "params": {
        "n": {
          "ref": "ema_fast"
        }
      }
    },
    {
      "id": "ema_s",
      "op": "ts.ema",
      "args": [
        "close"
      ],
      "params": {
        "n": {
          "ref": "ema_slow"
        }
      }
    },
    {
      "id": "roc_f",
      "op": "ts.roc",
      "args": [
        "ema_f"
      ],
      "params": {
        "k": {
          "ref": "roc_k"
        }
      }
    },
    {
      "id": "roc_s",
      "op": "ts.roc",
      "args": [
        "ema_s"
      ],
      "params": {
        "k": {
          "ref": "roc_k"
        }
      }
    },
    {
      "id": "roll_hi",
      "op": "ts.roll_max",
      "args": [
        "close"
      ],
      "params": {
        "n": {
          "ref": "break_n"
        }
      }
    },
    {
      "id": "roll_lo",
      "op": "ts.roll_min",
      "args": [
        "close"
      ],
      "params": {
        "n": {
          "ref": "break_n"
        }
      }
    },
    {
      "id": "prev_hi",
      "op": "ts.shift",
      "args": [
        "roll_hi"
      ],
      "params": {
        "k": 1
      }
    },
    {
      "id": "prev_lo",
      "op": "ts.shift",
      "args": [
        "roll_lo"
      ],
      "params": {
        "k": 1
      }
    },
    {
      "id": "zero",
      "op": "core.const",
      "params": {
        "value": 0.0
      }
    },
    {
      "id": "roc_floor",
      "op": "core.const",
      "params": {
        "value": {
          "ref": "roc_floor"
        }
      }
    }
  ],
  "bool_nodes": [
    {
      "id": "trend_up",
      "op": "cmp.gt",
      "args": [
        "ema_f",
        "ema_s"
      ]
    },
    {
      "id": "trend_dn",
      "op": "cmp.lt",
      "args": [
        "ema_f",
        "ema_s"
      ]
    },
    {
      "id": "cross_up",
      "op": "cmp.cross_up",
      "args": [
        "ema_f",
        "ema_s"
      ]
    },
    {
      "id": "cross_dn",
      "op": "cmp.cross_down",
      "args": [
        "ema_f",
        "ema_s"
      ]
    },
    {
      "id": "roc_f_pos",
      "op": "cmp.gt",
      "args": [
        "roc_f",
        "roc_floor"
      ]
    },
    {
      "id": "roc_f_neg",
      "op": "cmp.lt",
      "args": [
        "roc_f",
        "roc_floor"
      ]
    },
    {
      "id": "break_up",
      "op": "cmp.gt",
      "args": [
        "close",
        "prev_hi"
      ]
    },
    {
      "id": "break_dn",
      "op": "cmp.lt",
      "args": [
        "close",
        "prev_lo"
      ]
    },
    {
      "id": "allow_trade",
      "op": "logic.or",
      "args": [
        "trend_up",
        "trend_dn"
      ]
    },
    {
      "id": "entry_long",
      "op": "logic.and",
      "args": [
        "cross_up",
        "roc_f_pos"
      ]
    },
    {
      "id": "exit_long",
      "op": "logic.or",
      "args": [
        "cross_dn",
        "break_dn"
      ]
    },
    {
      "id": "entry_short",
      "op": "logic.and",
      "args": [
        "cross_dn",
        "roc_f_neg"
      ]
    },
    {
      "id": "exit_short",
      "op": "logic.or",
      "args": [
        "cross_up",
        "break_up"
      ]
    }
  ],
  "bindings": {
    "entry_long": "entry_long",
    "exit_long": "exit_long",
    "entry_short": "entry_short",
    "exit_short": "exit_short",
    "allow_trade": "allow_trade"
  }
}