{
  "version": 1,
  "name": "Trend-Filtered Breakout",
  "trade_mode": "LongShort",
  "exec_settings": {
    "initial_equity": 10000,
    "fill_timing": "close",
    "costs": { "fee_bps": 0.0, "slippage_bps": 0.0 }
  },
  "params": {
    "lookback": 20,
    "fast": 10,
    "slow": 50
  },
  "numeric_nodes": [
    { "id": "c",       "op": "core.close" },
    { "id": "hi",      "op": "ts.roll_max",  "args": ["c"], "params": { "n": { "ref": "lookback" } } },
    { "id": "lo",      "op": "ts.roll_min",  "args": ["c"], "params": { "n": { "ref": "lookback" } } },
    { "id": "hi_prev", "op": "ts.shift",     "args": ["hi"], "params": { "k": 1 } },
    { "id": "lo_prev", "op": "ts.shift",     "args": ["lo"], "params": { "k": 1 } },
    { "id": "f",       "op": "ts.sma",       "args": ["c"], "params": { "n": { "ref": "fast" } } },
    { "id": "s",       "op": "ts.sma",       "args": ["c"], "params": { "n": { "ref": "slow" } } }
  ],
  "bool_nodes": [
    { "id": "uptrend",      "op": "cmp.gt",         "args": ["f", "s"] },

    { "id": "downtrend",    "op": "logic.not",      "args": ["uptrend"] },

    { "id": "break_long",   "op": "cmp.cross_up",   "args": ["c", "hi_prev"] },
    { "id": "break_short",  "op": "cmp.cross_down", "args": ["c", "lo_prev"] },

    { "id": "entry_long",   "op": "logic.and",      "args": ["break_long",  "uptrend"] },
    { "id": "entry_short",  "op": "logic.and",      "args": ["break_short", "downtrend"] },

    { "id": "exit_long",    "op": "cmp.cross_down", "args": ["c", "lo_prev"] },
    { "id": "exit_short",   "op": "cmp.cross_up",   "args": ["c", "hi_prev"] }
  ],
  "bindings": {
    "entry_long":  "entry_long",
    "exit_long":   "exit_long",
    "entry_short": "entry_short",
    "exit_short":  "exit_short",
    "allow_trade": ""
  },
  "sweep": {
    "enabled": true,
    "engine": "coarse_fine",
    "objective": "pnl_dd",
    "dd_weight": 1.0,
    "top_k": 10,
    "max_evals": 2000,
    "engine_config": {
      "coarse_fine": {
        "k_stage1": 20,
        "k_stage2": 30,
        "depollute_stage1": true,
        "dedupe_stage2": true,
        "suppression_hops": 1,
        "stage2_hops": 1,
        "stage1_stride": 1
      }
    },
    "params": {
      "lookback": { "min": 10, "max": 50, "step": 5,  "is_int": true },
      "fast":     { "min":  5, "max": 20, "step": 5,  "is_int": true },
      "slow":     { "min": 30, "max": 100,"step": 10, "is_int": true }
    }
  }
}