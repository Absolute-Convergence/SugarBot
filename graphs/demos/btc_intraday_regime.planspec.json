{
  "version": 1,
  "name": "demo_btc_intraday_regime",
  "trade_mode": "LongShort",
  "exec_settings": {
    "initial_equity": 50000,
    "eval_mode": "NextBar",
    "fill_timing": "NextBarOpen",
    "costs": { "fee_bps": 2.0, "slippage_bps": 3.0 },
    "exits_first": true,
    "allow_same_bar_reversal": true,
    "close_out_at_end": true
  },
  "params": {
    "ema_fast": 8,
    "ema_slow": 34,
    "breakout_n": 28,
    "vol_fast": 6,
    "vol_slow": 36,
    "corr_n": 32,
    "entropy_n": 28,
    "entropy_bins": 10,
    "regime_n": 44,
    "trend_gate": 0.0,
    "vol_gate": 2.5,
    "entropy_gate": 2.1,
    "regime_gate": 0.35
  },
  "numeric_nodes": [
    { "id": "c", "op": "core.close" },
    { "id": "h", "op": "core.ref", "params": { "ref": "high" } },
    { "id": "l", "op": "core.ref", "params": { "ref": "low" } },
    { "id": "v", "op": "core.ref", "params": { "ref": "volume" } },
    { "id": "ema_f", "op": "ts.ema", "args": ["c"], "params": { "n": { "ref": "ema_fast" } } },
    { "id": "ema_s", "op": "ts.ema", "args": ["c"], "params": { "n": { "ref": "ema_slow" } } },
    { "id": "spread", "op": "ts.sub", "args": ["ema_f", "ema_s"] },
    { "id": "spread_delta", "op": "ts.delta", "args": ["spread"] },
    { "id": "hi", "op": "ts.roll_max", "args": ["c"], "params": { "n": { "ref": "breakout_n" } } },
    { "id": "lo", "op": "ts.roll_min", "args": ["c"], "params": { "n": { "ref": "breakout_n" } } },
    { "id": "hi_prev", "op": "ts.shift", "args": ["hi"], "params": { "k": 1 } },
    { "id": "lo_prev", "op": "ts.shift", "args": ["lo"], "params": { "k": 1 } },
    { "id": "tr", "op": "ts.true_range_ohlc", "args": ["h", "l", "c"] },
    { "id": "atr", "op": "ts.ema", "args": ["tr"], "params": { "n": 10 } },
    { "id": "vol_ratio", "op": "ts.volatility_ratio", "args": ["c"], "params": { "fast_n": { "ref": "vol_fast" }, "slow_n": { "ref": "vol_slow" } } },
    { "id": "ret", "op": "ts.roc", "args": ["c"], "params": { "k": 1 } },
    { "id": "flow", "op": "ts.roc", "args": ["v"], "params": { "k": 1 } },
    { "id": "flow_corr", "op": "ms.correlation", "args": ["ret", "flow"], "params": { "n": { "ref": "corr_n" } } },
    { "id": "entropy", "op": "ts.entropy", "args": ["ret"], "params": { "n": { "ref": "entropy_n" }, "bins": { "ref": "entropy_bins" } } },
    { "id": "autocorr", "op": "ts.autocorrelation", "args": ["ret"], "params": { "n": 40, "lag": 1 } },
    { "id": "regime", "op": "ts.regime_change", "args": ["c"], "params": { "n": { "ref": "regime_n" } } },
    { "id": "regime_norm", "op": "ts.normalize_minmax", "args": ["regime"], "params": { "n": 80 } },
    { "id": "corr_abs", "op": "ts.abs", "args": ["flow_corr"] },
    { "id": "trend_energy", "op": "ts.abs", "args": ["spread_delta"] },
    { "id": "risk_raw_a", "op": "ts.add", "args": ["vol_ratio", "entropy"] },
    { "id": "risk_raw", "op": "ts.add", "args": ["risk_raw_a", "regime_norm"] },
    { "id": "opportunity_a", "op": "ts.add", "args": ["trend_energy", "corr_abs"] },
    { "id": "opportunity", "op": "ts.sub", "args": ["opportunity_a", "risk_raw"] },
    { "id": "zero", "op": "core.const", "params": { "value": 0.0 } },
    { "id": "opportunity_floor", "op": "core.select", "args": ["opportunity_positive", "opportunity", "zero"] },
    { "id": "showcase_score", "op": "ts.normalize_minmax", "args": ["opportunity_floor"], "params": { "n": 100 } },
    { "id": "trend_gate_level", "op": "core.const", "params": { "value": { "ref": "trend_gate" } } },
    { "id": "vol_gate_level", "op": "core.const", "params": { "value": { "ref": "vol_gate" } } },
    { "id": "entropy_gate_level", "op": "core.const", "params": { "value": { "ref": "entropy_gate" } } },
    { "id": "regime_gate_level", "op": "core.const", "params": { "value": { "ref": "regime_gate" } } }
  ],
  "bool_nodes": [
    { "id": "opportunity_positive", "op": "cmp.gt", "args": ["opportunity", "zero"] },
    { "id": "spread_up", "op": "cmp.gt", "args": ["spread", "trend_gate_level"] },
    { "id": "spread_down", "op": "cmp.lt", "args": ["spread", "trend_gate_level"] },
    { "id": "accel_up", "op": "cmp.gt", "args": ["spread_delta", "zero"] },
    { "id": "accel_down", "op": "cmp.lt", "args": ["spread_delta", "zero"] },
    { "id": "break_up", "op": "cmp.cross_up", "args": ["c", "hi_prev"] },
    { "id": "break_down", "op": "cmp.cross_down", "args": ["c", "lo_prev"] },
    { "id": "vol_ok", "op": "cmp.lt", "args": ["vol_ratio", "vol_gate_level"] },
    { "id": "entropy_ok", "op": "cmp.lt", "args": ["entropy", "entropy_gate_level"] },
    { "id": "regime_ok", "op": "cmp.lt", "args": ["regime_norm", "regime_gate_level"] },
    { "id": "score_ok", "op": "cmp.gt", "args": ["showcase_score", "zero"] },
    { "id": "long_a", "op": "logic.and", "args": ["spread_up", "accel_up"] },
    { "id": "long_b", "op": "logic.and", "args": ["long_a", "break_up"] },
    { "id": "long_c", "op": "logic.and", "args": ["long_b", "vol_ok"] },
    { "id": "entry_l", "op": "logic.and", "args": ["long_c", "score_ok"] },
    { "id": "short_a", "op": "logic.and", "args": ["spread_down", "accel_down"] },
    { "id": "short_b", "op": "logic.and", "args": ["short_a", "break_down"] },
    { "id": "short_c", "op": "logic.and", "args": ["short_b", "entropy_ok"] },
    { "id": "entry_s", "op": "logic.and", "args": ["short_c", "score_ok"] },
    { "id": "exit_l_a", "op": "logic.or", "args": ["spread_down", "break_down"] },
    { "id": "exit_l", "op": "logic.or", "args": ["exit_l_a", "regime_ok"] },
    { "id": "exit_s_a", "op": "logic.or", "args": ["spread_up", "break_up"] },
    { "id": "exit_s", "op": "logic.or", "args": ["exit_s_a", "regime_ok"] },
    { "id": "allow_a", "op": "logic.and", "args": ["vol_ok", "entropy_ok"] },
    { "id": "allow_trade", "op": "logic.and", "args": ["allow_a", "regime_ok"] }
  ],
  "bindings": {
    "entry_long": "entry_l",
    "exit_long": "exit_l",
    "entry_short": "entry_s",
    "exit_short": "exit_s",
    "allow_trade": "allow_trade"
  },
  "sweep": {
    "enabled": true,
    "engine": "coarse_fine",
    "top_k": 8,
    "max_evals": 5000,
    "objective": "pnl_dd",
    "dd_weight": 1.4,
    "engine_config": {
      "coarse_fine": {
        "k_stage1": 32,
        "k_stage2": 80,
        "depollute_stage1": true,
        "dedupe_stage2": true,
        "suppression_hops": 1,
        "stage2_hops": 1,
        "coarse_step_multiplier": 3
      }
    },
    "result_diversity": {
      "enabled": true,
      "dedupe_trade_hash": true,
      "basin_aware": false,
      "oversample_multiplier": 8,
      "max_per_basin": 2,
      "param_bucket_size": 3,
      "min_param_distance": 0,
      "min_trades": 2
    },
    "params": {
      "ema_fast": { "values": [5, 8, 13], "is_int": true },
      "ema_slow": { "values": [21, 34, 55, 89], "is_int": true },
      "breakout_n": { "min": 12, "max": 60, "step": 4, "is_int": true },
      "vol_fast": { "values": [4, 6, 8], "is_int": true },
      "vol_slow": { "values": [24, 36, 48], "is_int": true },
      "corr_n": { "values": [24, 32, 48], "is_int": true },
      "entropy_gate": { "values": [1.8, 2.1, 2.4], "is_int": false },
      "regime_gate": { "values": [0.25, 0.35, 0.50], "is_int": false }
    }
  }
}
